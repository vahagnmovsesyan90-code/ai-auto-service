{
    "name": "aiauto-desktop",
    "version": "1.0.0",
    "private": true,
    "description": "AI Auto Service desktop shell (Windows, macOS, Linux)",
    "author": "AI Auto Service",
    "main": "main.js",
    "scripts": {
        "start": "electron . --dev",
        "start:prod": "electron . --prod",
        "pack": "electron-builder --config electron-builder.config.cjs --dir",
        "dist:win": "electron-builder --config electron-builder.config.cjs --win",
        "dist:mac": "electron-builder --config electron-builder.config.cjs --mac",
        "dist:linux": "electron-builder --config electron-builder.config.cjs --linux"
    },
    "devDependencies": {
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3"
    }
}
