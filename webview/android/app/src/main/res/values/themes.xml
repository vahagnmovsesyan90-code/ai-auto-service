<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AiAuto" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
    <style name="Theme.AiAuto.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AiAuto</item>
    </style>
</resources>
