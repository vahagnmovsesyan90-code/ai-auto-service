# Պատճենեք որպես .env և լրացրեք
APP_ENV=production
ADMIN_PASSWORD=երկար-գաղտնաբառ-այստեղ
SECRET_KEY=պատահական-երկար-տող          # python -c "import secrets;print(secrets.token_hex(32))"
ANTHROPIC_API_KEY=                      # դատարկ՝ chat-ը կաշխատի պարզ ռեժիմում
DATABASE_URL=postgresql://autoservice:autoservice@127.0.0.1:5433/autoservice   # Postgres (տեղականը՝ docker compose up -d db)
SEED_SAMPLE=0                           # 0՝ առանց նմուշային գարաժների (իրական տվյալներ)

# Հավելվածի ներբեռնման էջ (/download). խանութների հղումները, երբ հավելվածը հրապարակված է
# APP_STORE_URL=
# PLAY_STORE_URL=
# DOWNLOADS_DIR=downloads
