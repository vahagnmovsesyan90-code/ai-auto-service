# Պատճենեք որպես .env և լրացրեք
APP_ENV=production
ADMIN_PASSWORD=երկար-գաղտնաբառ-այստեղ
SECRET_KEY=պատահական-երկար-տող          # python -c "import secrets;print(secrets.token_hex(32))"
ANTHROPIC_API_KEY=                      # դատարկ՝ chat-ը կաշխատի պարզ ռեժիմում
AUTOSERVICE_DB=/data/autoservice.db
SEED_SAMPLE=0                           # 0՝ առանց նմուշային գարաժների (իրական տվյալներ)
